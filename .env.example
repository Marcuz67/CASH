# Copy to .env for local development. Never commit .env or database credentials.
# Google settings are only needed later; the current browser-only demo needs none.
# Use the Web application client ID from Google Auth Platform (not a client secret).
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Comma-separated Google emails approved to manage the shared store.
ADMIN_EMAILS=approved-seller@gmail.com
# Use http://localhost:3000 locally. On Render, use https://cash-rqu6.onrender.com.
APP_ORIGIN=http://localhost:3000
# Required only for first-time Admin creation on Render: choose a private random key
# of at least 32 characters. Localhost setup does not require a key. Remove it after setup.
ADMIN_SETUP_TOKEN=
# DATABASE_URL is required on Render. Leave it unset locally to use SQLite.
