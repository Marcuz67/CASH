rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsApprovedAccount(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && (request.auth.token.admin == true || request.auth.token.approved == true);
    }

    match /users/{userId}/{path=**} {
      allow read: if ownsApprovedAccount(userId);
      allow create, update: if ownsApprovedAccount(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsApprovedAccount(userId);
    }
  }
}
