rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isApproved() {
      return signedIn() && (request.auth.token.admin == true || request.auth.token.approved == true);
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';
      allow update: if signedIn()
        && request.auth.uid == userId
        && isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'shopName', 'location'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /shops/{userId} {
      allow read: if isApproved() && request.auth.uid == userId;
      allow create, update: if isApproved() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['state', 'updatedAt']);
      allow delete: if false;
    }
  }
}
